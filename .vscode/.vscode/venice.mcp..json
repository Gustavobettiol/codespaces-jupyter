{
  "inputs": [
    {
      "type": "promptString",
      "id": "venice-key",
      "description": "Venice API key (venice.ai/settings/api)",
      "password": true
    }
  ],
  "servers": {
    "venice": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@veniceai/mcp-server@0.3.0"],
      "env": {
        "VENICE_API_KEY": "${input:venice-key}",
        "VENICE_DISABLE_NSFW": "0",
        "VENICE_DEFAULT_CHAT_MODEL": "venice-uncensored",
        "VENICE_DEFAULT_IMAGE_MODEL": "flux-2-pro",
        "VENICE_DEFAULT_TTS_MODEL": "tts-kokoro",
        "VENICE_HTTP_TIMEOUT_MS": "600000",
        "VENICE_MAX_VIDEO_RESPONSE_BYTES": "26214400"
      }
    }
  }
}
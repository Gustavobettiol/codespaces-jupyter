{
  "name": "arg-ai",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "hostRequirements": { "cpus": 2 },
  "waitFor": "onCreateCommand",
  "onCreateCommand": "npm install",
  "updateContentCommand": "python3 -m pip install -r requirements.txt || true",
  "postStartCommand": "pkill -f 'node src/index.js' 2>/dev/null; nohup npm start > server.log 2>&1 &",
  "forwardPorts": [3001],
  "portsAttributes": {
    "3001": { "label": "API + Escena", "visibility": "public", "onAutoForward": "notify" }
  },
  "customizations": {
    "codespaces": { "openFiles": ["README.md"] },
    "vscode": { "extensions": ["ms-toolsai.jupyter", "ms-python.python"] }
  }
}
